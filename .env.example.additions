# Agregar/ajustar estas líneas en tu .env:

# --- Local (SQLite, sin schema) ---
DB_CONNECTION=sqlite
# Borra o comenta DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD, DB_SCHEMA

# --- Producción en Render (Postgres compartido, schema propio) ---
# DB_CONNECTION=pgsql
# DB_HOST=<host interno o el de la External Connection String>
# DB_PORT=5432
# DB_DATABASE=door_to_door
# DB_USERNAME=cotizador_user
# DB_PASSWORD=<la password que pusiste en sql/001_schema_setup.sql>
# DB_SCHEMA=cotizador
# DB_SSLMODE=require    # "require" con la External Connection String; quítalo o usa "prefer" con host interno

# Opcional — habilita el botón "Analizar plano" en la UI:
ANTHROPIC_API_KEY=
